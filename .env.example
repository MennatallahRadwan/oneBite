# Must match the credentials in docker-compose.yml
DATABASE_URL="postgresql://onebite:freelancing@localhost:5433/onebite?schema=public"
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Owner dashboard. See ADMIN_SETUP.md for how to generate these.
# 32-byte key, either base64-encoded or 64 hex characters.
OWNER_TOTP_ENCRYPTION_KEY=""

# Read only by `npm run owner:bootstrap` when creating the owner account.
OWNER_EMAIL=""
OWNER_PASSWORD=""
OWNER_TOTP_SECRET=""
