DATABASE_URL="postgresql://onebite:freelancing@localhost:5433/onebite?schema=public"
TEST_DATABASE_URL="postgresql://onebite:freelancing@localhost:5433/onebite_test?schema=public"
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Deployment: see DEPLOYMENT.md and render.yaml.
# CLIENT_ORIGIN must be the exact storefront origin, for example
# https://www.onebite.example. Do not use "*" because CORS credentials are
# required for owner session cookies.
# SITE_ORIGIN is substituted into dist/sitemap.xml during `npm run build`.
# SITE_ORIGIN="https://www.onebite.example"

# In production the API also serves the built SPA from dist/, which keeps the
# session cookies same-site. Both of these exist only to opt out of that:
# SERVE_CLIENT="false"  # API only; the SPA is hosted elsewhere.
# TRUST_PROXY="false"   # Not behind a reverse proxy. Leave unset on Render.

# Only needed if the SPA is built for a different origin than the API. Left
# unset, the client calls /api/v1 on its own origin, which is the supported
# single-service layout.
# VITE_API_URL="https://api.onebite.example/api/v1"

OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="use-a-long-unique-password"
OWNER_TOTP_SECRET="paste-base32-secret"
OWNER_TOTP_ENCRYPTION_KEY="paste-32-byte-base64-key"

# Future production uploads should use object storage rather than local files.
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
