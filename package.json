{
  "name": "one-bite-vue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && npm run sitemap:origin",
    "preview": "vite preview",
    "server:dev": "tsx watch server/src/index.ts",
    "server:start": "tsx server/src/index.ts",
    "server:test": "tsx server/scripts/prepare-test-db.ts && vitest run --config server/vitest.config.ts",
    "server:test:dev-db": "npm run prisma:seed && vitest run --config server/vitest.config.ts",
    "smoke:sync": "tsx server/scripts/smoke-sync.ts",
    "db:setup": "npm run prisma:generate && npm run deploy:db && npm run prisma:seed",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "prisma:seed": "tsx server/prisma/seed.ts",
    "owner:bootstrap": "tsx server/scripts/bootstrap-owner.ts",
    "sitemap:origin": "tsx scripts/apply-site-origin.ts",
    "deploy:db": "prisma db push --schema server/prisma/schema.prisma --skip-generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@vitejs/plugin-vue": "latest",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "lucide-vue-next": "latest",
    "pinia": "latest",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "typescript": "5.9.3",
    "vite": "latest",
    "vue": "latest",
    "vue-router": "latest",
    "vue-tsc": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  }
}
